# =============================================================================
# 🔧 OPTIMIZED .htaccess - NUXT STATIC + PHP SUPPORT FIXED
# =============================================================================

# 🐘 PHP Handler (cPanel - DO NOT EDIT)
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>

# =============================================================================
# 🚀 NUXT STATIC APP + PHP SUPPORT
# =============================================================================

DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ──────────────────────────────────────────────────────────────
  # 🌐 1. DEFAULT REDIRECT: / → /sr (HIGHEST PRIORITY)
  # ──────────────────────────────────────────────────────────────
  # Redirect root (and only root) to /sr/
  RewriteRule ^$ /sr/ [L,R=301]

  # ──────────────────────────────────────────────────────────────
  # 🐘 2. PHP FILES - SERVE DIRECTLY
  # ──────────────────────────────────────────────────────────────
  # If request is for a PHP file that exists, serve it directly
  RewriteCond %{REQUEST_FILENAME} \.php$ [NC]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # ──────────────────────────────────────────────────────────────
  # 📁 3. SERVE EXISTING FILES & DIRECTORIES
  # ──────────────────────────────────────────────────────────────
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # ──────────────────────────────────────────────────────────────
  # 📄 4. PRERENDERED HTML ROUTES (Nuxt Static)
  # ──────────────────────────────────────────────────────────────

  # Handle /sr/ routes → /sr/index.html
  # This catches /sr, /sr/, /sr/anything, /sr/anything/
  RewriteCond %{REQUEST_URI} ^/sr(/|$) [NC]
  RewriteRule ^sr(/.*)?$ /sr/index.html [L]

  # Handle sub-routes: /about → /about/index.html (if exists)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{1,6}$ [NC]
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # Handle sub-routes: /about → /about.html (if exists)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{1,6}$ [NC]
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # ──────────────────────────────────────────────────────────────
  # 🎯 5. SPA FALLBACK (Client-Side Routing)
  # ──────────────────────────────────────────────────────────────
  # ⚠️ IMPORTANT: This MUST be the LAST rule
  # Only executed if no static file, HTML file, or PHP file exists
  # Redirect to root index.html (which will handle client-side routing)
  RewriteRule ^ index.html [L]
</IfModule>

# =============================================================================
# 🔐 HEADERS & CACHING
# =============================================================================

<IfModule mod_headers.c>
  # Security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Cache static assets aggressively
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Cache HTML files moderately
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # No cache for data files
  <FilesMatch "\.(json|xml|txt)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # PHP files: Disable caching
  <FilesMatch "\.(php|php8|phtml)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
  </FilesMatch>
</IfModule>

# =============================================================================
# 📁 PHP FILES - SPECIFIC CONFIG
# =============================================================================

<FilesMatch "\.(php|php8|phtml)$">
    # Allow PHP files
    Require all granted

    # Ensure PHP handler is applied
    SetHandler application/x-httpd-ea-php82

    # Disable caching
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
</FilesMatch>

# =============================================================================
# 🗜️ COMPRESSION
# =============================================================================

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/json application/xml application/rss+xml image/svg+xml font/woff2 application/x-httpd-php
</IfModule>

# =============================================================================
# 📌 END OF CONFIGURATION
# =============================================================================
