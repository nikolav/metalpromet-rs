# =============================================================================
# 🔧 OPTIMIZED .htaccess - NUXT STATIC + PHP SUPPORT + SECURITY
# =============================================================================

# 🐘 PHP Handler (cPanel - DO NOT EDIT)
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>

# =============================================================================
# 🚀 NUXT STATIC APP + PHP SUPPORT
# =============================================================================

DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ──────────────────────────────────────────────────────────────
  # 🌐 1. DEFAULT REDIRECT: / → /sr (HIGHEST PRIORITY)
  # ──────────────────────────────────────────────────────────────
  # Redirect root (and only root) to /sr/
  RewriteRule ^$ /sr/ [L,R=301]

  # ──────────────────────────────────────────────────────────────
  # 🛡️ 2. SECURITY - BLOCK MALICIOUS REQUESTS (BEFORE ANYTHING ELSE)
  # ──────────────────────────────────────────────────────────────

  # Block WordPress attack patterns (return 404)
  RewriteRule ^wp-admin/ - [R=404,L]
  RewriteRule ^wp-content/ - [R=404,L]
  RewriteRule ^wp-includes/ - [R=404,L]
  RewriteRule ^wp-.*\.php$ - [R=404,L]

  # Block common malicious PHP files (return 404)
  RewriteRule ^(.*\.(php|phtml))$ - [R=404,L]

  # Block directory traversal attempts
  RewriteCond %{REQUEST_URI} (\.\./|\.\.\\) [NC,OR]
  RewriteCond %{QUERY_STRING} (\.\./|\.\.\\) [NC]
  RewriteRule .* - [R=404,L]

  # ──────────────────────────────────────────────────────────────
  # 🛡️ 3. SECURITY - BLOCK KNOWN MALICIOUS USER-AGENTS
  # ──────────────────────────────────────────────────────────────

  # Block CMS-Checker, Palo Alto scanners, HeadlessChrome, Gort
  RewriteCond %{HTTP_USER_AGENT} (cms-checker|palto-alto|palo-alto|headlesschrome|headless-chrome|gort|netcraftsurvey) [NC]
  RewriteRule .* - [F,L]

  # Block empty user-agents (often bots)
  RewriteCond %{HTTP_USER_AGENT} ^-?$ [OR]
  RewriteCond %{HTTP_USER_AGENT} ^$ [OR]
  RewriteCond %{HTTP_USER_AGENT} ^\s*$
  RewriteRule .* - [F,L]

  # ──────────────────────────────────────────────────────────────
  # 🛡️ 4. SECURITY - BLOCK KNOWN MALICIOUS IP ADDRESSES
  # ──────────────────────────────────────────────────────────────

  # WordPress attack sources
  RewriteCond %{REMOTE_ADDR} ^20\.203\.142\.71$ [OR]
  RewriteCond %{REMOTE_ADDR} ^158\.158\.76\.106$ [OR]
  RewriteCond %{REMOTE_ADDR} ^188\.240\.209\.9$ [OR]
  RewriteCond %{REMOTE_ADDR} ^20\.203\.205\.96$
  RewriteRule .* - [F,L]

  # ──────────────────────────────────────────────────────────────
  # 🛡️ 5. SECURITY - BLOCK REFERER SPAM
  # ──────────────────────────────────────────────────────────────

  RewriteCond %{HTTP_REFERER} ^.*(porn|sex|xxx|casino|gambling|viagra|poker|betting|drugs).*$ [NC]
  RewriteRule .* - [F,L]

  # ──────────────────────────────────────────────────────────────
  # 🛡️ 6. SECURITY - PROTECT SENSITIVE FILES
  # ──────────────────────────────────────────────────────────────

  # Block access to .env, .git, .log, .json, .map files
  RewriteRule ^(\.env|\.git|\.log|composer\.json|composer\.lock|package\.json|package-lock\.json|yarn\.lock|\.htaccess|\.htpasswd) - [F,L]

  # ──────────────────────────────────────────────────────────────
  # 🛡️ 7. SECURITY - PREVENT DIRECTORY LISTING
  # ──────────────────────────────────────────────────────────────

  Options -Indexes

  # ──────────────────────────────────────────────────────────────
  # 🐘 8. PHP FILES - SERVE DIRECTLY
  # ──────────────────────────────────────────────────────────────

  # If request is for a PHP file that exists, serve it directly
  RewriteCond %{REQUEST_FILENAME} \.php$ [NC]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # ──────────────────────────────────────────────────────────────
  # 📁 9. SERVE EXISTING FILES & DIRECTORIES
  # ──────────────────────────────────────────────────────────────

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # ──────────────────────────────────────────────────────────────
  # 📄 10. PRERENDERED HTML ROUTES (Nuxt Static)
  # ──────────────────────────────────────────────────────────────

  # Handle /sr/ routes → /sr/index.html
  RewriteCond %{REQUEST_URI} ^/sr(/|$) [NC]
  RewriteRule ^sr(/.*)?$ /sr/index.html [L]

  # Handle sub-routes: /about → /about/index.html (if exists)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{1,6}$ [NC]
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # Handle sub-routes: /about → /about.html (if exists)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{1,6}$ [NC]
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # ──────────────────────────────────────────────────────────────
  # 🎯 11. SPA FALLBACK (Client-Side Routing)
  # ──────────────────────────────────────────────────────────────

  # ⚠️ IMPORTANT: This MUST be the LAST rule
  RewriteRule ^ index.html [L]
</IfModule>

# =============================================================================
# 🔐 HEADERS & CACHING
# =============================================================================

<IfModule mod_headers.c>

  # ──────────────────────────────────────────────────────────────
  # 🔒 SECURITY HEADERS
  # ──────────────────────────────────────────────────────────────

  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Remove server signature (hide Apache version)
  Header unset Server
  Header unset X-Powered-By

  # ──────────────────────────────────────────────────────────────
  # 🤖 ROBOTS HEADERS - Prevent indexing of _nuxt/
  # ──────────────────────────────────────────────────────────────

  <FilesMatch "^_nuxt/.*\.(js|css|map|json)$">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>

  # ──────────────────────────────────────────────────────────────
  # 📦 CACHE HEADERS
  # ──────────────────────────────────────────────────────────────

  # Cache static assets aggressively (1 year)
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Cache HTML files moderately (1 hour)
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # No cache for data files
  <FilesMatch "\.(json|xml|txt)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # PHP files: Disable caching
  <FilesMatch "\.(php|php8|phtml)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
  </FilesMatch>

</IfModule>

# =============================================================================
# 📁 PHP FILES - SPECIFIC CONFIG
# =============================================================================

<FilesMatch "\.(php|php8|phtml)$">
    # Allow PHP files
    Require all granted

    # Ensure PHP handler is applied
    SetHandler application/x-httpd-ea-php82

    # Disable caching
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
</FilesMatch>

# =============================================================================
# 🗜️ COMPRESSION
# =============================================================================

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/json application/xml application/rss+xml image/svg+xml font/woff2 application/x-httpd-php
</IfModule>

# =============================================================================
# 🔒 ADDITIONAL FILE PROTECTION
# =============================================================================

# Block access to .htaccess, .htpasswd, .env, .git, .log files
<FilesMatch "^(\.htaccess|\.htpasswd|\.env|\.gitignore|\.gitattributes|\.log|composer\.json|composer\.lock|package\.json|package-lock\.json|yarn\.lock)$">
    Require all denied
</FilesMatch>

# Block access to _nuxt/ source maps (security)
<FilesMatch "^_nuxt/.*\.map$">
    Require all denied
</FilesMatch>

# =============================================================================
# 🌐 CORS HEADERS (if needed for APIs)
# =============================================================================

<IfModule mod_headers.c>
    # Uncomment if you need CORS for API endpoints
    # <FilesMatch "\.(json|xml)$">
    #     Header set Access-Control-Allow-Origin "*"
    # </FilesMatch>
</IfModule>

# =============================================================================
# 📌 END OF CONFIGURATION
# =============================================================================
